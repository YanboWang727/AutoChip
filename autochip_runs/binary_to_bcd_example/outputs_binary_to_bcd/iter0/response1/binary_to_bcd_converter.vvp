#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x1055f2c60 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1055eea90 .scope module, "tb" "tb" 3 3;
 .timescale -9 -12;
v0x1055f9b10_0 .net "bcd_output", 7 0, L_0x1055f9f70;  1 drivers
v0x1055f9bb0_0 .var "binary_input", 4 0;
v0x1055f9c50_0 .var "expected_bcd", 7 0;
v0x1055f9cf0_0 .var/i "i", 31 0;
v0x1055f9d90_0 .var/i "mismatches", 31 0;
v0x1055f9e30_0 .var "test_binary", 4 0;
v0x1055f9ed0_0 .var "vcd_clk", 0 0;
S_0x1055eec10 .scope module, "uut" "binary_to_bcd_converter" 3 8, 4 1 0, S_0x1055eea90;
 .timescale 0 0;
    .port_info 0 /INPUT 5 "binary_input";
    .port_info 1 /OUTPUT 8 "bcd_output";
v0x1055f2de0_0 .net "bcd_output", 7 0, L_0x1055f9f70;  alias, 1 drivers
v0x1055f9930_0 .net "binary_input", 4 0, v0x1055f9bb0_0;  1 drivers
v0x1055f99d0_0 .var "ones", 3 0;
v0x1055f9a70_0 .var "tens", 3 0;
E_0x1055f6ec0 .event anyedge, v0x1055f9930_0;
L_0x1055f9f70 .concat [ 4 4 0 0], v0x1055f99d0_0, v0x1055f9a70_0;
    .scope S_0x1055eec10;
T_0 ;
    %wait E_0x1055f6ec0;
    %load/vec4 v0x1055f9930_0;
    %cmpi/u 10, 0, 5;
    %jmp/0xz  T_0.0, 5;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x1055f9a70_0, 0, 4;
    %load/vec4 v0x1055f9930_0;
    %parti/s 4, 0, 2;
    %store/vec4 v0x1055f99d0_0, 0, 4;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x1055f9930_0;
    %cmpi/u 20, 0, 5;
    %jmp/0xz  T_0.2, 5;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x1055f9a70_0, 0, 4;
    %load/vec4 v0x1055f9930_0;
    %subi 10, 0, 5;
    %pad/u 4;
    %store/vec4 v0x1055f99d0_0, 0, 4;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x1055f9930_0;
    %cmpi/u 30, 0, 5;
    %jmp/0xz  T_0.4, 5;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x1055f9a70_0, 0, 4;
    %load/vec4 v0x1055f9930_0;
    %subi 20, 0, 5;
    %pad/u 4;
    %store/vec4 v0x1055f99d0_0, 0, 4;
    %jmp T_0.5;
T_0.4 ;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x1055f9a70_0, 0, 4;
    %load/vec4 v0x1055f9930_0;
    %subi 30, 0, 5;
    %pad/u 4;
    %store/vec4 v0x1055f99d0_0, 0, 4;
T_0.5 ;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x1055eea90;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x1055f9d90_0, 0, 32;
    %vpi_call/w 3 20 "$display", "Testing Binary-to-BCD Converter..." {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x1055f9cf0_0, 0, 32;
T_1.0 ; Top of for-loop
    %load/vec4 v0x1055f9cf0_0;
    %cmpi/s 32, 0, 32;
	  %jmp/0xz T_1.1, 5;
    %load/vec4 v0x1055f9cf0_0;
    %pad/s 5;
    %store/vec4 v0x1055f9e30_0, 0, 5;
    %load/vec4 v0x1055f9e30_0;
    %store/vec4 v0x1055f9bb0_0, 0, 5;
    %load/vec4 v0x1055f9e30_0;
    %pad/u 32;
    %pushi/vec4 10, 0, 32;
    %mod;
    %pad/u 4;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x1055f9c50_0, 4, 4;
    %load/vec4 v0x1055f9e30_0;
    %pad/u 32;
    %pushi/vec4 10, 0, 32;
    %div;
    %pad/u 4;
    %ix/load 4, 4, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x1055f9c50_0, 4, 4;
    %delay 10000, 0;
    %load/vec4 v0x1055f9b10_0;
    %load/vec4 v0x1055f9c50_0;
    %cmp/ne;
    %jmp/0xz  T_1.3, 6;
    %load/vec4 v0x1055f9d90_0;
    %addi 1, 0, 32;
    %store/vec4 v0x1055f9d90_0, 0, 32;
    %vpi_call/w 3 34 "$display", "Error: Test case %0d failed. Expected BCD: 8'b%0b, Got: 8'b%0b", v0x1055f9e30_0, v0x1055f9c50_0, v0x1055f9b10_0 {0 0 0};
T_1.3 ;
T_1.2 ; for-loop step statement
    ; show_stmt_assign_vector: Get l-value for compressed += operand
    %load/vec4 v0x1055f9cf0_0;
    %pushi/vec4 1, 0, 32;
    %add;
    %store/vec4 v0x1055f9cf0_0, 0, 32;
    %jmp T_1.0;
T_1.1 ; for-loop exit label
    %vpi_call/w 3 39 "$display", "Mismatches: %0d in 32 samples", v0x1055f9d90_0 {0 0 0};
    %vpi_call/w 3 40 "$finish", 32'sb00000000000000000000000000000000 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x1055eea90;
T_2 ;
    %vpi_call/w 3 45 "$dumpfile", "my_design.vcd" {0 0 0};
    %vpi_call/w 3 46 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x1055eea90 {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x1055eea90;
T_3 ;
    %delay 5000, 0;
    %load/vec4 v0x1055f9ed0_0;
    %inv;
    %store/vec4 v0x1055f9ed0_0, 0, 1;
    %jmp T_3;
    .thread T_3;
