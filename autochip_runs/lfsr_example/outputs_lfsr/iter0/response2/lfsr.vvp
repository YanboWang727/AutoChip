    %assign/vec4 v0x986c34280_0, 0;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x105b32180;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x986c34500_0;
    %inv;
    %store/vec4 v0x986c34500_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x105b32180;
T_3 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x986c34780_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x986c348c0_0, 0, 32;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x986c34500_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x986c34820_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x986c34820_0, 0, 1;
    %load/vec4 v0x986c348c0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x986c348c0_0, 0, 32;
    %load/vec4 v0x986c345a0_0;
    %cmpi/ne 138, 0, 8;
    %jmp/0xz  T_3.0, 6;
    %load/vec4 v0x986c34780_0;
    %addi 1, 0, 32;
    %store/vec4 v0x986c34780_0, 0, 32;
    %vpi_call/w 3 50 "$display", "Error: At time %t, data = %b, expected = 10001010", $time, v0x986c345a0_0 {0 0 0};
T_3.0 ;
    %pushi/vec4 138, 0, 8;
    %store/vec4 v0x986c34640_0, 0, 8;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x986c346e0_0, 0, 32;
T_3.2 ; Top of for-loop
    %load/vec4 v0x986c346e0_0;
    %cmpi/s 256, 0, 32;
	  %jmp/0xz T_3.3, 5;
    %load/vec4 v0x986c34640_0;
    %store/vec4 v0x986c343c0_0, 0, 8;
    %callf/vec4 TD_tb.reference_lfsr_output, S_0x105b3b050;
    %store/vec4 v0x986c34640_0, 0, 8;
    %delay 10000, 0;
    %load/vec4 v0x986c348c0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x986c348c0_0, 0, 32;
    %load/vec4 v0x986c345a0_0;
    %load/vec4 v0x986c34640_0;
    %cmp/ne;
