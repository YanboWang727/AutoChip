 .timescale -9 -12;
v0x986c343c0_0 .var "current_state", 7 0;
; Variable reference_lfsr_output is vec4 return value of scope S_0x105b3b050
TD_tb.reference_lfsr_output ;
    %load/vec4 v0x986c343c0_0;
    %parti/s 7, 0, 2;
    %load/vec4 v0x986c343c0_0;
    %parti/s 1, 0, 2;
    %load/vec4 v0x986c343c0_0;
    %parti/s 1, 3, 3;
    %xor;
    %load/vec4 v0x986c343c0_0;
    %parti/s 1, 5, 4;
    %xor;
    %load/vec4 v0x986c343c0_0;
    %parti/s 1, 6, 4;
    %xor;
    %concat/vec4; draw_concat_vec4
    %ret/vec4 0, 0, 8;  Assign to reference_lfsr_output (store_vec4_to_lval)
    %end;
    .scope S_0x105b2ea40;
T_1 ;
    %wait E_0x986c30180;
    %load/vec4 v0x986c34320_0;
    %nor/r;
    %flag_set/vec4 8;
