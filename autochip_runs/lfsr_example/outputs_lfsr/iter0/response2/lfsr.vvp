    %load/vec4 v0x986c34780_0;
    %addi 1, 0, 32;
    %store/vec4 v0x986c34780_0, 0, 32;
    %vpi_call/w 3 69 "$display", "Error: At time %t, data = %b, expected = %b", $time, v0x986c345a0_0, v0x986c34640_0 {0 0 0};
T_3.5 ;
T_3.4 ; for-loop step statement
    %load/vec4 v0x986c346e0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x986c346e0_0, 0, 32;
    %jmp T_3.2;
T_3.3 ; for-loop exit label
    %vpi_call/w 3 73 "$display", "Mismatches: %0d in %0d samples", v0x986c34780_0, v0x986c348c0_0 {0 0 0};
    %vpi_call/w 3 74 "$finish", 32'sb00000000000000000000000000000000 {0 0 0};
