T_3.0 ;
    %pushi/vec4 138, 0, 8;
    %store/vec4 v0x8e90408c0_0, 0, 8;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x8e9040960_0, 0, 32;
T_3.2 ; Top of for-loop
    %load/vec4 v0x8e9040960_0;
    %cmpi/s 256, 0, 32;
	  %jmp/0xz T_3.3, 5;
    %load/vec4 v0x8e90408c0_0;
