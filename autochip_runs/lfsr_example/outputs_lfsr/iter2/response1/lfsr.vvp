    %store/vec4 v0x8e9040a00_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x8e9040b40_0, 0, 32;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x8e9040780_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x8e9040aa0_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x8e9040aa0_0, 0, 1;
    %load/vec4 v0x8e9040b40_0;
    %addi 1, 0, 32;
    %store/vec4 v0x8e9040b40_0, 0, 32;
    %load/vec4 v0x8e9040820_0;
    %cmpi/ne 138, 0, 8;
    %jmp/0xz  T_3.0, 6;
    %load/vec4 v0x8e9040a00_0;
